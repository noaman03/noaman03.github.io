---
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-name" href="/#home">Ahmed Noaman</a>
      <p>Flutter developer. Cairo, Egypt.</p>
    </div>
    <nav class="footer-links" aria-label="Footer links">
      <a href="/#projects">Projects</a>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ahmed Noaman on GitHub (opens in a new tab)">GitHub</a
      >
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ahmed Noaman on LinkedIn (opens in a new tab)">LinkedIn</a
      >
      <a href={`mailto:${profile.email}`}>Email</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <div>
      <p>© {new Date().getFullYear()} Ahmed Mohamed Noaman.</p>
      <p>Built with Astro, TypeScript, and Tailwind CSS.</p>
    </div>
  </div>
</footer>
