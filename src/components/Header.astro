---
import { profile } from '../data/profile';

const navLinks = [
  ['Projects', '/#projects'],
  ['Skills', '/#skills'],
  ['About', '/#about'],
  ['Contact', '/#contact'],
] as const;
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand-mark" href="/#home">Ahmed Noaman</a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navLinks.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        class="header-social"
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ahmed Noaman on GitHub (opens in a new tab)"
      >
        GitHub
      </a>
      <a
        class="header-social"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ahmed Noaman on LinkedIn (opens in a new tab)"
      >
        LinkedIn
      </a>
      <a
        class="button button-small header-cv"
        href={profile.cv}
        download="Ahmed-Mohamed-Noaman-CV.pdf"
      >
        Download CV
      </a>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        aria-pressed="false"
        data-theme-toggle
      >
        <svg
          class="theme-icon theme-icon-light"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5Z"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-dark"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="3.1"></circle>
          <path
            d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1"
          ></path>
        </svg>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-navigation"
    class="mobile-navigation"
    hidden
    data-mobile-navigation
  >
    <nav aria-label="Mobile navigation">
      {navLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      <a href={profile.cv} download="Ahmed-Mohamed-Noaman-CV.pdf">Download CV</a
      >
      <div class="mobile-socials">
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ahmed Noaman on GitHub (opens in a new tab)">GitHub</a
        >
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ahmed Noaman on LinkedIn (opens in a new tab)">LinkedIn</a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNavigation = document.querySelector<HTMLElement>(
    '[data-mobile-navigation]',
  );
  const themeButton = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );

  const closeMenu = () => {
    if (!menuButton || !mobileNavigation) return;
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Open navigation menu');
    mobileNavigation.hidden = true;
  };

  menuButton?.addEventListener('click', () => {
    if (!mobileNavigation) return;
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    menuButton.setAttribute(
      'aria-label',
      isOpen ? 'Open navigation menu' : 'Close navigation menu',
    );
    mobileNavigation.hidden = isOpen;
  });

  mobileNavigation
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', closeMenu));

  window.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      menuButton?.getAttribute('aria-expanded') === 'true'
    ) {
      closeMenu();
      menuButton.focus();
    }
  });

  window
    .matchMedia('(min-width: 900px)')
    .addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });

  const updateThemeButton = () => {
    if (!themeButton) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    themeButton.setAttribute('aria-pressed', String(isDark));
    themeButton.setAttribute(
      'aria-label',
      `Switch to ${isDark ? 'light' : 'dark'} theme`,
    );
  };

  updateThemeButton();
  themeButton?.addEventListener('click', () => {
    const nextTheme =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem('portfolio-theme', nextTheme);
    } catch {
      /* private mode: the choice simply does not persist */
    }
    updateThemeButton();
  });
</script>
