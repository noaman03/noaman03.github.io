---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Ahmed Noaman"
  description="The requested page could not be found."
  canonicalPath="/404/"
>
  <section class="notfound">
    <div class="section-shell">
      <h1 class="display">That page is not here.</h1>
      <p class="lead hero-lead">
        The portfolio has a home page and eight project pages. Nothing else.
      </p>
      <div class="button-row">
        <a class="button" href="/">Go to the home page</a>
        <a class="button button-secondary" href="/#projects">See the projects</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
