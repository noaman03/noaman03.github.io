---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DeviceLadder from '../components/DeviceLadder.astro';
import {
  additionalProjects,
  featuredProjects,
  getProject,
  projects,
} from '../data/projects';
import {
  certifications,
  expertise,
  profile,
  secondaryCertifications,
  studied,
} from '../data/profile';

const strong8k = getProject('strong-8k');
const shippedCount = projects.filter(
  (project) => (project.links?.length ?? 0) > 0,
).length;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: profile.site,
    email: `mailto:${profile.email}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Alexandria',
      addressCountry: 'EG',
    },
    sameAs: [profile.github, profile.linkedin],
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Arab Academy for Science, Technology & Maritime Transport',
    },
    knowsAbout: [
      'Flutter',
      'Dart',
      'Clean Architecture',
      'Firebase',
      'Supabase',
      'Mobile application development',
    ],
  },
  ...projects.map((project) => ({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: project.name,
    applicationCategory: project.category,
    description: project.summary,
    url: `${profile.site}/projects/${project.slug}/`,
    codeRepository: project.repository,
    ...(project.apkUrl ? { downloadUrl: project.apkUrl } : {}),
    author: { '@type': 'Person', name: profile.name },
    operatingSystem: project.platforms ?? 'Android',
  })),
];
---

<BaseLayout structuredData={structuredData}>
  <section id="home" class="hero-section" aria-labelledby="hero-title">
    <div class="section-shell">
      <h1 id="hero-title" class="display">
        <span>I build software for</span>{' '}
        <span>screens people watch</span>{' '}
        <span>from across the room.</span>
      </h1>

      <p class="lead hero-lead">
        Flutter developer in Alexandria. For three months this year I built
        Strong 8K — a live TV and on-demand client for Android, Android TV and
        Windows. 73,576 lines of Dart, 2,603 passing tests, and it is on Google
        Play and the Microsoft Store.
      </p>

      <div class="button-row">
        <a class="button" href="/projects/strong-8k/"
          >Read the Strong 8K case study</a
        >
        <a
          class="button button-secondary"
          href={profile.cv}
          download="Ahmed-Mohamed-Noaman-CV.pdf">Download CV</a
        >
      </div>

      {strong8k?.ladder && <DeviceLadder ladder={strong8k.ladder} eager />}
    </div>
  </section>

  <section
    id="projects"
    class="section-block section-divider"
    aria-labelledby="projects-title"
  >
    <div class="section-shell">
      <div class="heading-row">
        <h2 id="projects-title" class="section-heading">Projects</h2>
        <p class="meta">
          {projects.length} total. {shippedCount} in a store.
        </p>
      </div>

      <div class="projects-grid">
        {
          featuredProjects.map((project) => (
            /* Nothing above the fold is a project thumbnail any more: the
               ladder is the hero, so these all load lazily. */
            <ProjectCard project={project} />
          ))
        }
      </div>

      <div
        id="additional-projects"
        class="projects-more"
        hidden
        data-additional-projects
      >
        {additionalProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="projects-toggle-wrap">
        <button
          class="button button-secondary projects-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="additional-projects"
          data-projects-toggle
        >
          <span class="toggle-more"
            >Show the other {additionalProjects.length} projects</span
          >
          <span class="toggle-fewer">Show fewer projects</span>
        </button>
      </div>
    </div>
  </section>

  <section
    id="skills"
    class="section-block section-divider"
    aria-labelledby="skills-title"
  >
    <div class="section-shell">
      <div class="heading-row">
        <h2 id="skills-title" class="section-heading">What I work with</h2>
      </div>

      <dl class="table-rows">
        {
          expertise.map((group) => (
            <div class="table-row">
              <dt>{group.title}</dt>
              <dd>{group.skills.join(', ')}</dd>
            </div>
          ))
        }
      </dl>

      <div class="table-unproven">
        <p>{studied.note}</p>
        <dl class="table-rows">
          <div class="table-row">
            <dt>Studied, not shipped</dt>
            <dd>{studied.skills.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section
    id="about"
    class="section-block section-divider"
    aria-labelledby="about-title"
  >
    <div class="section-shell">
      <div class="heading-row">
        <h2 id="about-title" class="section-heading">About</h2>
      </div>

      <div class="split">
        <div class="prose">
          <p>
            I am in my final year of Computer Engineering at the Arab Academy
            for Science, Technology and Maritime Transport, in Alexandria, and I
            finished AMIT Learning's Flutter diploma with 95%.
          </p>
          <p>
            From July to October 2026 I took Strong 8K from an empty repository
            to two stores as the only developer: the Flutter client, the Kotlin
            playback view, a Node.js service on Ubuntu behind nginx, a build
            driver that produces fifteen branded builds from one codebase, and
            the store submissions. The tests moved with the code — of 195
            commits, 153 touched the application and 150 touched the test suite.
          </p>
          <p>
            Before that I worked on Khayyer, my graduation project, and on a set
            of smaller Flutter builds that are on this page as what they are. A
            background in networking and security is why I think about
            credentials, data boundaries and what a log is allowed to print.
          </p>
          <p>
            I have since finished a DevOps Engineering diploma at Andalusia
            covering Docker, Kubernetes, Terraform, Ansible, Jenkins, Argo CD,
            Prometheus and Grafana. None of it is in Strong 8K, which runs on
            plain Linux, systemd and nginx, and the skills list above says so.
          </p>
          <div class="button-row">
            <a
              class="button button-secondary"
              href={profile.cv}
              download="Ahmed-Mohamed-Noaman-CV.pdf">Download CV</a
            >
          </div>
        </div>

        <dl class="facts">
          <div><dt>Degree</dt><dd>B.Sc. Computer Engineering</dd></div>
          <div><dt>University</dt><dd>AASTMT, Alexandria</dd></div>
          <div><dt>Period</dt><dd>2021 – expected 2026</dd></div>
          <div><dt>Flutter diploma</dt><dd>AMIT Learning, 95%</dd></div>
          <div><dt>DevOps diploma</dt><dd>Andalusia, 2026</dd></div>
          <div><dt>Arabic</dt><dd>Native</dd></div>
          <div><dt>English</dt><dd>C1+</dd></div>
          <div><dt>Based</dt><dd>Alexandria, Egypt</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section
    class="section-block section-divider"
    aria-labelledby="credentials-title"
  >
    <div class="section-shell">
      <div class="heading-row">
        <h2 id="credentials-title" class="section-heading">
          Education and certificates
        </h2>
      </div>

      {
        /*
        The degree, the university and the dates are already in the About
        facts table directly above. A second table repeating them was the one
        accessory this page did not need, so the certificates stand alone.
      */
      }
      <div class="credential-block">
        <ul class="credential-list">
          {certifications.map((certification) => <li>{certification}</li>)}
        </ul>
        <details>
          <summary>{secondaryCertifications.length} more credentials</summary>
          <ul class="credential-list">
            {
              secondaryCertifications.map((certification) => (
                <li>{certification}</li>
              ))
            }
          </ul>
        </details>
      </div>
    </div>
  </section>

  <section
    id="contact"
    class="section-block section-divider"
    aria-labelledby="contact-title"
  >
    <div class="section-shell">
      <h2 id="contact-title" class="section-heading contact-heading">
        I am open to Flutter roles, internships and freelance work.
      </h2>
      <div class="contact-list">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ahmed Noaman on GitHub (opens in a new tab)"
          >github.com/noaman03</a
        >
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ahmed Noaman on LinkedIn (opens in a new tab)">LinkedIn</a
        >
        <span class="meta">Alexandria, Egypt</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const projectsToggle = document.querySelector<HTMLButtonElement>(
    '[data-projects-toggle]',
  );
  const additionalProjects = document.querySelector<HTMLElement>(
    '[data-additional-projects]',
  );

  /* No reveal animation. The label and the count say what changed. */
  projectsToggle?.addEventListener('click', () => {
    if (!additionalProjects) return;
    const willExpand = projectsToggle.getAttribute('aria-expanded') !== 'true';
    projectsToggle.setAttribute('aria-expanded', String(willExpand));
    additionalProjects.hidden = !willExpand;
    if (!willExpand) {
      document.querySelector('#projects')?.scrollIntoView({ block: 'start' });
      projectsToggle.focus({ preventScroll: true });
    }
  });
</script>
