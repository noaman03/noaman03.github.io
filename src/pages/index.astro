---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  additionalProjects,
  featuredProjects,
  projects,
} from '../data/projects';
import {
  certifications,
  expertise,
  profile,
  secondaryCertifications,
} from '../data/profile';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: profile.site,
    email: `mailto:${profile.email}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Alexandria',
      addressCountry: 'EG',
    },
    sameAs: [profile.github, profile.linkedin],
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Arab Academy for Science, Technology & Maritime Transport',
    },
    knowsAbout: [
      'Flutter',
      'Dart',
      'Clean Architecture',
      'Firebase',
      'Supabase',
      'Mobile application development',
    ],
  },
  ...projects.map((project) => ({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: project.name,
    applicationCategory: project.category,
    description: project.summary,
    url: `${profile.site}/projects/${project.slug}/`,
    codeRepository: project.repository,
    author: { '@type': 'Person', name: profile.name },
    operatingSystem: project.slug === 'psa-academy' ? 'Web' : 'Android',
  })),
];
---

<BaseLayout structuredData={structuredData}>
  <section id="home" class="hero-section" aria-labelledby="hero-title">
    <div class="section-shell hero-grid">
      <div>
        <p class="availability">
          Open to Flutter roles, internships, and freelance work
        </p>
        <h1 id="hero-title" class="hero-title">
          Ahmed Noaman
          <span>Flutter Developer & Mobile Application Engineer</span>
        </h1>
        <p class="hero-copy">
          I build secure, scalable cross-platform applications with Flutter,
          thoughtful architecture, and modern state management. My work turns
          complex product requirements into maintainable mobile experiences.
        </p>
        <div class="hero-actions">
          <a class="button" href="#projects"
            >View My Projects <span aria-hidden="true">↓</span></a
          >
          <a
            class="button button-secondary"
            href={profile.cv}
            download="Ahmed-Mohamed-Noaman-CV.pdf">Download CV</a
          >
          <a class="button button-ghost" href={`mailto:${profile.email}`}
            >Contact Me</a
          >
        </div>
        <div class="hero-actions" aria-label="Professional profiles">
          <a
            class="text-link"
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ahmed Noaman on GitHub (opens in a new tab)"
            >GitHub <span aria-hidden="true">↗</span></a
          >
          <a
            class="text-link"
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ahmed Noaman on LinkedIn (opens in a new tab)"
            >LinkedIn <span aria-hidden="true">↗</span></a
          >
        </div>
        <p class="expertise-line">
          Flutter · Dart · Clean Architecture · Riverpod · BLoC · Firebase ·
          Supabase
        </p>
      </div>
      <aside class="hero-proof" aria-label="Portfolio overview">
        <div class="proof-header" aria-hidden="true">
          <span></span><span></span><span></span><code
            >mobile-engineering.dart</code
          >
        </div>
        <dl class="proof-list">
          <div><dt>focus</dt><dd>Flutter & cross-platform mobile</dd></div>
          <div><dt>work</dt><dd>7 completed portfolio applications</dd></div>
          <div><dt>method</dt><dd>Evidence-led architecture and UI</dd></div>
          <div><dt>based</dt><dd>Alexandria, Egypt</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section
    id="projects"
    class="section-block section-divider"
    aria-labelledby="projects-title"
  >
    <div class="section-shell">
      <div class="projects-heading-row">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="projects-title" class="section-heading">
            Built applications, not generic claims.
          </h2>
        </div>
        <p class="section-intro">
          Explore real Flutter interfaces, repository-verified engineering
          decisions, and clear boundaries between implemented, simulated, and
          research-scope functionality.
        </p>
      </div>

      <div class="projects-grid" aria-label="Featured projects">
        {
          featuredProjects.map((project, index) => (
            <ProjectCard
              project={project}
              lead={index === 0}
              eager={index === 0}
            />
          ))
        }
      </div>

      <div
        id="additional-projects"
        class="projects-more"
        hidden
        data-additional-projects
      >
        {additionalProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="projects-toggle-wrap">
        <button
          class="button button-secondary projects-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="additional-projects"
          data-projects-toggle
        >
          <span class="toggle-more">Show More Projects</span>
          <span class="toggle-fewer">Show Fewer Projects</span>
          <span aria-hidden="true">↓</span>
        </button>
      </div>
    </div>
  </section>

  <section
    id="skills"
    class="section-block section-divider"
    aria-labelledby="skills-title"
  >
    <div class="section-shell">
      <p class="eyebrow">Technical expertise</p>
      <h2 id="skills-title" class="section-heading">
        Flutter first. Full application thinking throughout.
      </h2>
      <p class="section-intro">
        My core focus is mobile development, supported by practical experience
        across architecture, backend integration, real-time systems, security,
        and specialized technology.
      </p>
      <div class="expertise-grid">
        {
          expertise.map((group) => (
            <article class:list={['expertise-card', { accent: group.accent }]}>
              <h3>{group.title}</h3>
              <ul>
                {group.skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="about"
    class="section-block section-divider"
    aria-labelledby="about-title"
  >
    <div class="section-shell about-grid">
      <div class="about-copy">
        <p class="eyebrow">About me</p>
        <h2 id="about-title" class="section-heading section-heading-small">
          Engineering mobile products with a broader systems perspective.
        </h2>
        <p>
          I’m a Computer Engineering student at the Arab Academy for Science,
          Technology & Maritime Transport and a Flutter developer focused on
          secure, scalable cross-platform applications. I completed AMIT
          Learning’s Flutter Diploma with a 95% grade.
        </p>
        <p>
          My project work spans Clean Architecture, Riverpod, BLoC, Firebase,
          Supabase, local persistence, APIs, and real-time communication. A
          background in networking and cybersecurity shapes how I think about
          authentication, data boundaries, and secure-by-design implementation.
        </p>
        <p>
          I have also worked with computer vision, blockchain integration,
          native iOS development in Swift, and backend services—useful context
          when a mobile feature has to cross platform or system boundaries.
        </p>
        <div class="hero-actions">
          <a
            class="button button-secondary"
            href={profile.cv}
            download="Ahmed-Mohamed-Noaman-CV.pdf">Download CV</a
          >
          <a class="text-link" href="#contact"
            >Start a conversation <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <dl class="about-facts">
        <div class="about-fact">
          <dt>Current study</dt><dd>B.Sc. Computer Engineering</dd>
        </div>
        <div class="about-fact">
          <dt>University</dt><dd>
            Arab Academy for Science, Technology & Maritime Transport
          </dd>
        </div>
        <div class="about-fact">
          <dt>Degree period</dt><dd>2021–Expected 2026</dd>
        </div>
        <div class="about-fact">
          <dt>Flutter diploma</dt><dd>AMIT Learning · Grade 95%</dd>
        </div>
        <div class="about-fact">
          <dt>Languages</dt><dd>Arabic — Native · English — C1+</dd>
        </div>
        <div class="about-fact">
          <dt>Location</dt><dd>Alexandria, Egypt</dd>
        </div>
      </dl>
    </div>
  </section>

  <section
    class="section-block section-divider"
    aria-labelledby="credentials-title"
  >
    <div class="section-shell">
      <p class="eyebrow">Education & credentials</p>
      <h2 id="credentials-title" class="section-heading section-heading-small">
        Continuous learning across mobile, backend, and security.
      </h2>
      <div class="credentials-grid">
        <article class="credential-card">
          <h3>B.Sc. Computer Engineering</h3>
          <p>Arab Academy for Science, Technology & Maritime Transport</p>
          <p>2021–Expected 2026</p>
        </article>
        <article class="credential-card">
          <h3>Selected certifications</h3>
          <ul class="credential-list">
            {certifications.map((certification) => <li>{certification}</li>)}
          </ul>
          <details class="secondary-certifications">
            <summary>Additional credentials</summary>
            <ul class="credential-list">
              {
                secondaryCertifications.map((certification) => (
                  <li>{certification}</li>
                ))
              }
            </ul>
          </details>
        </article>
      </div>
    </div>
  </section>

  <section
    id="contact"
    class="section-block section-divider"
    aria-labelledby="contact-title"
  >
    <div class="section-shell contact-card">
      <div class="contact-grid">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title" class="section-heading section-heading-small">
            Let’s build a thoughtful mobile experience.
          </h2>
          <p class="section-intro">
            I’m open to Flutter roles, internships, and freelance projects where
            strong mobile implementation and clear product thinking matter.
          </p>
          <div class="contact-actions">
            <a class="button" href={`mailto:${profile.email}`}>Email Me</a>
            <a
              class="button button-secondary"
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              >LinkedIn <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <dl class="contact-links">
          <div>
            <dt>Email</dt><dd>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </dd>
          </div>
          <div>
            <dt>GitHub</dt><dd>
              <a href={profile.github} target="_blank" rel="noopener noreferrer"
                >github.com/noaman03 <span aria-hidden="true">↗</span></a
              >
            </dd>
          </div>
          <div>
            <dt>LinkedIn</dt><dd>
              <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                >Ahmed Noaman <span aria-hidden="true">↗</span></a
              >
            </dd>
          </div>
          <div><dt>Location</dt><dd>Alexandria, Egypt</dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const projectsToggle = document.querySelector<HTMLButtonElement>(
    '[data-projects-toggle]',
  );
  const additionalProjects = document.querySelector<HTMLElement>(
    '[data-additional-projects]',
  );

  projectsToggle?.addEventListener('click', () => {
    if (!additionalProjects) return;
    const willExpand = projectsToggle.getAttribute('aria-expanded') !== 'true';
    projectsToggle.setAttribute('aria-expanded', String(willExpand));
    additionalProjects.hidden = !willExpand;
    additionalProjects.classList.toggle('is-revealed', willExpand);
    if (!willExpand) {
      document.querySelector('#projects')?.scrollIntoView({ block: 'start' });
      projectsToggle.focus({ preventScroll: true });
    }
  });
</script>
