---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';
import { projects, type Project } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: Project };
const { project } = Astro.props;
const pageTitle = `${project.name} | Ahmed Noaman Flutter Portfolio`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  applicationCategory: project.category,
  description: project.summary,
  url: `${profile.site}/projects/${project.slug}/`,
  codeRepository: project.repository,
  author: { '@type': 'Person', name: profile.name },
  operatingSystem: project.slug === 'psa-academy' ? 'Web' : 'Android',
};
---

<BaseLayout
  title={pageTitle}
  description={project.summary}
  canonicalPath={`/projects/${project.slug}/`}
  image={project.thumbnail.src}
  structuredData={structuredData}
>
  <article>
    <header class="project-detail-hero">
      <div class="section-shell">
        <a class="back-link" href="/#projects">← Back to all projects</a>
        <div class="detail-grid">
          <div class="detail-copy">
            <p class="eyebrow">{project.category}</p>
            <h1>{project.name}</h1>
            <p class="detail-summary">{project.summary}</p>
            <ul
              class="stack-list"
              aria-label={`${project.name} technology stack`}
            >
              {project.stack.map((technology) => <li>{technology}</li>)}
            </ul>
            <div class="project-actions" aria-label={`${project.name} actions`}>
              {
                project.video && (
                  <button
                    class="button"
                    type="button"
                    data-video-trigger
                    data-project={project.name}
                    data-video={project.video}
                    data-video-type={project.videoType}
                    data-poster={project.thumbnail.src}
                  >
                    Watch Demo
                  </button>
                )
              }
              <button
                class="button button-secondary"
                type="button"
                data-gallery-trigger
                data-project={project.name}
                data-gallery={JSON.stringify(project.gallery)}
              >
                View Screenshots
              </button>
              <a
                class="button button-ghost"
                href={project.repository}
                target="_blank"
                rel="noopener noreferrer"
                >Source Code <span aria-hidden="true">↗</span></a
              >
              {
                project.liveUrl && (
                  <a
                    class="button button-ghost"
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Open Live App <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>
          </div>
          <div class="detail-media">
            <OptimizedPicture
              image={project.thumbnail}
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 900px) 50vw, 100vw"
            />
          </div>
        </div>
      </div>
    </header>

    <section
      class="section-block section-divider"
      aria-labelledby="overview-title"
    >
      <div class="section-shell detail-content-grid">
        <div class="prose-block">
          <h2 id="overview-title">Project overview</h2>
          {project.overview.map((paragraph) => <p>{paragraph}</p>)}
          <h3>Verified engineering highlights</h3>
          <ul>
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          {
            project.funding && (
              <p class="project-funding">
                {project.funding.statement}{' '}
                <a
                  href={project.funding.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Learn about ITIDA
                </a>
              </p>
            )
          }
          {
            project.disclaimer && (
              <p class="project-disclaimer">{project.disclaimer}</p>
            )
          }
        </div>
        <aside class="prose-block" aria-labelledby="technical-title">
          <h2 id="technical-title">Technical snapshot</h2>
          <h3>Status</h3>
          <p>{project.status}</p>
          <h3>Architecture</h3>
          <p>{project.architecture}</p>
          <h3>Implementation boundary</h3>
          <p class="evidence-note">
            {
              project.note ??
                'Only repository-verified functionality is described.'
            }
          </p>
        </aside>
      </div>
    </section>

    <section
      class="section-block section-divider"
      aria-labelledby="gallery-title"
    >
      <div class="section-shell">
        <p class="eyebrow">Selected application media</p>
        <h2 id="gallery-title" class="section-heading section-heading-small">
          Screens chosen for clarity, variety, and privacy.
        </h2>
        <p class="section-intro">
          Open any image for a full-screen, keyboard-accessible gallery.
        </p>
        <div class="project-gallery-grid">
          {
            project.gallery.map((image, index) => (
              <button
                class="gallery-thumbnail"
                type="button"
                data-gallery-trigger
                data-project={project.name}
                data-gallery={JSON.stringify(project.gallery)}
                data-gallery-start={index}
                aria-label={`Open ${project.name} screenshot ${index + 1}: ${image.alt}`}
              >
                <OptimizedPicture
                  image={image}
                  sizes="(min-width: 768px) 25vw, 50vw"
                />
                <span aria-hidden="true">View {index + 1}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
