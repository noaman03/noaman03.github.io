---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptimizedPicture from '../../components/OptimizedPicture.astro';
import DeviceLadder from '../../components/DeviceLadder.astro';
import { projects, type Project } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: Project };
const { project } = Astro.props;
const pageTitle = `${project.name} | Ahmed Noaman Flutter Portfolio`;

/* The gallery takes its shape from the images, never the other way round.
   Strong 8K and Khayyer are landscape captures; the rest are portrait phone
   captures. Nothing is cropped to fit a box it was not exported for. */
const isLandscape = project.gallery.every(
  (image) => image.width >= image.height,
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  applicationCategory: project.category,
  description: project.summary,
  url: `${profile.site}/projects/${project.slug}/`,
  ...(project.repository ? { codeRepository: project.repository } : {}),
  ...(project.apkUrl ? { downloadUrl: project.apkUrl } : {}),
  author: { '@type': 'Person', name: profile.name },
  operatingSystem: project.platforms ?? 'Android',
};
---

<BaseLayout
  title={pageTitle}
  description={project.summary}
  canonicalPath={`/projects/${project.slug}/`}
  image={project.thumbnail.src}
  structuredData={structuredData}
>
  <article>
    <header class="detail-hero">
      <div class="section-shell">
        <a class="back-link" href="/#projects">Back to projects</a>

        <h1 class="display">{project.name}</h1>

        <p class="lead detail-lead">{project.summary}</p>

        <div class="button-row" aria-label={`${project.name} links`}>
          {
            project.links?.map((link) => (
              <a
                class="button"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} on ${link.label} (opens in a new tab)`}
              >
                Open the {link.label} listing
              </a>
            ))
          }
          {
            project.liveUrl && (
              <a
                class="button"
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open the live ${project.name} web application (opens in a new tab)`}
              >
                Open the live app
              </a>
            )
          }
          {
            project.video && (
              <button
                class="button button-secondary"
                type="button"
                data-video-trigger
                data-project={project.name}
                data-video={project.video}
                data-video-type={project.videoType}
                data-poster={project.thumbnail.src}
              >
                Watch the demo
              </button>
            )
          }
          {
            project.repository && (
              <a
                class="button-ghost"
                href={project.repository}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} source code on GitHub (opens in a new tab)`}
              >
                Source code
              </a>
            )
          }
          {
            project.apkUrl && (
              <a
                class="button-ghost"
                href={project.apkUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Download the ${project.name} Android demo APK (opens in a new tab)`}
              >
                Download the APK
              </a>
            )
          }
        </div>

        {
          project.ladder ? (
            <DeviceLadder ladder={project.ladder} eager />
          ) : (
            <figure class="screen-well">
              <OptimizedPicture
                image={project.thumbnail}
                loading="eager"
                fetchpriority="high"
                sizes="(min-width: 1120px) 1040px, (min-width: 768px) 92vw, 100vw"
              />
              <figcaption>
                {project.name} on {project.platforms ?? 'Android'}.
              </figcaption>
            </figure>
          )
        }
      </div>
    </header>

    <section
      class="section-block section-divider"
      aria-labelledby="overview-title"
    >
      <div class="section-shell detail-split">
        <div class="prose">
          <h2 id="overview-title" class="section-heading">What it is</h2>
          {project.overview.map((paragraph) => <p>{paragraph}</p>)}
          {
            !project.caseStudy && (
              <>
                <h3 class="subhead">What it does</h3>
                <ul class="bullets">
                  {project.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </>
            )
          }
          {
            project.funding && (
              <p class="project-note">
                {project.funding.statement}{' '}
                <a
                  href={project.funding.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Learn about ITIDA
                </a>
              </p>
            )
          }
          {
            project.disclaimer && (
              <p class="project-note">{project.disclaimer}</p>
            )
          }
        </div>

        <aside aria-labelledby="facts-title">
          <h2 id="facts-title" class="section-heading">
            {project.caseStudy ? 'Shipped' : 'At a glance'}
          </h2>
          <dl class="facts">
            {
              project.caseStudy ? (
                project.caseStudy.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))
              ) : (
                <>
                  <div>
                    <dt>Status</dt>
                    <dd>{project.status}</dd>
                  </div>
                  <div>
                    <dt>Platforms</dt>
                    <dd>{project.platforms ?? 'Android'}</dd>
                  </div>
                  <div>
                    <dt>Screenshots</dt>
                    <dd>{project.gallery.length}</dd>
                  </div>
                </>
              )
            }
          </dl>
          <div class="prose aside-prose">
            <h3 class="subhead">How it is built</h3>
            <p>{project.architecture}</p>
          </div>
        </aside>
      </div>
    </section>

    {
      project.caseStudy && (
        <section
          class="section-block section-divider"
          aria-labelledby="problems-title"
        >
          <div class="section-shell">
            <div class="heading-row">
              <h2 id="problems-title" class="section-heading">
                Three problems worth describing
              </h2>
            </div>
            {project.caseStudy.problems.map((problem) => (
              <article class="case-problem">
                <h3>{problem.title}</h3>
                <hr class="case-rule" />
                <div class="prose">
                  {problem.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section
      class="section-block section-divider"
      aria-labelledby="gallery-title"
    >
      <div class="section-shell">
        <div class="heading-row">
          <h2 id="gallery-title" class="section-heading">
            {project.gallery.length} screenshots
          </h2>
          <p class="meta">Arrow keys move. Escape closes.</p>
        </div>

        <div
          class:list={[
            'gallery-grid',
            isLandscape ? 'gallery-grid-landscape' : 'gallery-grid-portrait',
          ]}
        >
          {
            project.gallery.map((image, index) => (
              <div class="gallery-item">
                <button
                  class="gallery-thumbnail"
                  type="button"
                  data-gallery-trigger
                  data-project={project.name}
                  data-gallery={JSON.stringify(project.gallery)}
                  data-gallery-start={index}
                  aria-label={`Open screenshot ${index + 1} of ${project.gallery.length} full screen: ${image.alt}`}
                >
                  <OptimizedPicture
                    image={image}
                    sizes={
                      isLandscape
                        ? '(min-width: 768px) 45vw, 92vw'
                        : '(min-width: 768px) 22vw, 45vw'
                    }
                  />
                </button>
                <p class="gallery-caption">{image.alt}</p>
              </div>
            ))
          }
        </div>

        <p class="evidence-note">
          {
            project.note ??
              'Only functionality that the public repository verifies is described here.'
          }
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
