---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaDialogs from '../components/MediaDialogs.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = 'Ahmed Noaman | Flutter developer, Cairo and Alexandria',
  description = 'Ahmed Noaman builds software for screens people watch from across the room. Strong 8K, a live TV and on-demand client for Android, Android TV and Windows, is on Google Play and the Microsoft Store.',
  canonicalPath = '/',
  image = '/og.png',
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, profile.site).toString();
const imageUrl = new URL(image, profile.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0c0a" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/archivo-var.woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ahmed Noaman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ahmed Noaman, Flutter developer in Cairo and Alexandria"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('portfolio-theme');
          const preferred = matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
          document.documentElement.dataset.theme =
            stored === 'light' || stored === 'dark' ? stored : preferred;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MediaDialogs />
    <div class="focus-ring" data-focus-ring-box aria-hidden="true"></div>

    <script>
      /* Strong 8K is driven by a D-pad, where a single bright box tells you
         where you are and moves between targets. The portfolio's focus
         indicator does the same thing: one box, 90ms. If this script never
         runs, the stylesheet's own :focus-visible outline is what shows, so
         focus is always visible either way. Reduced motion keeps the box and
         drops the transition, which the stylesheet handles. */
      const box = document.querySelector<HTMLElement>('[data-focus-ring-box]');
      const supported = (() => {
        try {
          document.querySelector(':focus-visible');
          return true;
        } catch {
          return false;
        }
      })();

      if (box && supported) {
        document.documentElement.dataset.focusRing = 'on';

        const hide = () => box.setAttribute('data-visible', 'false');

        const follow = () => {
          const target = document.querySelector(':focus-visible');
          /* A modal dialog paints over the box, so inside one the dialog's
             own outline does the job and the box stands down. */
          if (!target || target.closest('dialog[open]')) return hide();
          const rect = target.getBoundingClientRect();
          if (rect.width === 0 && rect.height === 0) return hide();
          box.style.width = `${rect.width + 6}px`;
          box.style.height = `${rect.height + 6}px`;
          box.style.transform = `translate(${rect.left + window.scrollX - 3}px, ${
            rect.top + window.scrollY - 3
          }px)`;
          box.setAttribute('data-visible', 'true');
        };

        let settle = 0;
        const followInstantly = () => {
          box.setAttribute('data-instant', 'true');
          follow();
          window.clearTimeout(settle);
          settle = window.setTimeout(
            () => box.removeAttribute('data-instant'),
            120,
          );
        };

        document.addEventListener('focusin', follow);
        document.addEventListener('focusout', hide);
        window.addEventListener('resize', followInstantly);
        window.addEventListener('scroll', followInstantly, { passive: true });
      }
    </script>
  </body>
</html>
